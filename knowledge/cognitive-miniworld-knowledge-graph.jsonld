      ],
      "testedBy": [
        "cmw:experiment/distractor-flood"
      ],
      "mitigates": [
        "cmw:failure/novelty-hijack"
      ],
      "@id": "cmw:primitive/salience-router",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "MetacontrolAllocator",
      "implementationTier": "adaptive",
      "contractQuestion": "Which computation is worth running, and when should it stop?",
      "objective": "Allocate cognitive computation by expected marginal decision value.",
      "inputType": [
        "cmw:contract/resource-budget",
        "cmw:contract/self-estimate",
        "cmw:contract/processing-priority"
      ],
      "outputType": [
        "cmw:contract/compute-allocation"
      ],
      "dependsOn": [
        "cmw:primitive/salience-router"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/salience-executive-network-distinction",
        "cmw:claim/expected-value-of-control",
        "cmw:claim/resource-rational-method"
      ],
      "testedBy": [
        "cmw:experiment/compute-budget",
        "cmw:experiment/sensor-degradation"
      ],
      "mitigates": [
        "cmw:failure/overthinking-sink"
      ],
      "@id": "cmw:primitive/metacontrol-allocator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "EpistemicController",
      "implementationTier": "adaptive",
      "contractQuestion": "What information-seeking action is expected to produce useful learning?",
      "objective": "Prefer expected learning progress over raw surprise and abandon irreducible noise.",
      "inputType": [
        "cmw:contract/belief-state",
        "cmw:contract/prediction-distribution",
        "cmw:contract/error-bundle",
        "cmw:contract/resource-budget"
      ],
      "outputType": [
        "cmw:contract/action-proposal"
      ],
      "dependsOn": [
        "cmw:primitive/forward-model",
        "cmw:primitive/error-decomposer"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/intrinsic-motivation-typology",
        "cmw:claim/human-learning-progress",
        "cmw:claim/stochastic-curiosity-failure"
      ],
      "testedBy": [
        "cmw:experiment/learnable-unknown",
        "cmw:experiment/noisy-tv"
      ],
      "mitigates": [
        "cmw:failure/noisy-tv",
        "cmw:failure/novelty-hijack"
      ],
      "@id": "cmw:primitive/epistemic-controller",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "EpisodicRecorder",
      "implementationTier": "learning",
      "contractQuestion": "What experience should be preserved with its provenance?",
      "objective": "Store fast, sparse, inspectable episodes without immediately rewriting general knowledge.",
      "inputType": [
        "cmw:contract/experience-trace"
      ],
      "outputType": [
        "cmw:contract/experience-trace"
      ],
      "dependsOn": [
        "cmw:primitive/error-decomposer",
        "cmw:primitive/action-arbitrator"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/complementary-learning-systems"
      ],
      "testedBy": [
        "cmw:experiment/contextual-episodic-retrieval",
        "cmw:experiment/consolidation-interference",
        "cmw:experiment/stale-memory"
      ],
      "@id": "cmw:primitive/episodic-recorder",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "WorkingMemoryGate",
      "implementationTier": "learning",
      "contractQuestion": "What representation should be admitted, maintained, replaced, or suppressed?",
      "objective": "Bound active state and reduce context churn.",
      "inputType": [
        "cmw:contract/processing-priority",
        "cmw:contract/belief-state",
        "cmw:contract/resource-budget"
      ],
      "outputType": [
        "cmw:contract/workspace-state"
      ],
      "dependsOn": [
        "cmw:primitive/salience-router"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/working-memory-gating-model"
      ],
      "testedBy": [
        "cmw:experiment/working-memory-interference"
      ],
      "mitigates": [
        "cmw:failure/context-churn"
      ],
      "@id": "cmw:primitive/working-memory-gate",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "CreditAssigner",
      "implementationTier": "learning",
      "contractQuestion": "Which earlier mechanisms and actions contributed to the current outcome?",
      "objective": "Apply delayed updates only to eligible contributors and reduce superstition.",
      "inputType": [
        "cmw:contract/experience-trace",
        "cmw:contract/error-bundle"
      ],
      "outputType": [
        "cmw:contract/experience-trace"
      ],
      "dependsOn": [
        "cmw:primitive/episodic-recorder",
