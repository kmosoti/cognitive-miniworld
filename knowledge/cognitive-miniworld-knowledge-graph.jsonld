    {
      "label": "Noisy-TV trap",
      "description": "Raw prediction error attracts the agent to irreducibly stochastic stimuli.",
      "@id": "cmw:failure/noisy-tv",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Novelty hijack",
      "description": "High novelty displaces low-novelty but viability-critical signals.",
      "@id": "cmw:failure/novelty-hijack",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Stale-memory substitution",
      "description": "Retrieved history substitutes for current state estimation.",
      "@id": "cmw:failure/stale-memory-substitution",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Global-credit superstition",
      "description": "All active mechanisms are reinforced after success, including noncausal contributors.",
      "@id": "cmw:failure/global-credit-superstition",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Habit rigidity",
      "description": "A cheap procedural policy persists after the environment changes.",
      "@id": "cmw:failure/habit-rigidity",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Overthinking sink",
      "description": "The system spends more compute than the decision can repay.",
      "@id": "cmw:failure/overthinking-sink",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Scalar-error collapse",
      "description": "Prediction, control, timing, and outcome errors are merged and cause incorrect updates.",
      "@id": "cmw:failure/scalar-error-collapse",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Anatomical overmapping",
      "description": "Logical software boxes are mistaken for one-to-one neuroanatomical modules.",
      "@id": "cmw:failure/anatomical-overmapping",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Language substitution",
      "description": "Fluent text is mistaken for state estimation, control, or learning.",
      "@id": "cmw:failure/language-substitution",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Proxy regulation",
      "description": "The system optimizes a convenient metric while violating the underlying viability condition.",
      "@id": "cmw:failure/proxy-regulation",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Model staleness",
      "description": "The forward model remains confident after transition dynamics change.",
      "@id": "cmw:failure/model-staleness",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Affordance blindness",
      "description": "The candidate generator omits a feasible high-value action or repeatedly proposes impossible actions.",
      "@id": "cmw:failure/affordance-blindness",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Context churn",
      "description": "Bounded active state repeatedly evicts causally or viability-relevant information.",
      "@id": "cmw:failure/context-churn",
      "@type": "cmw:FailureMode"
    },
    {
      "label": "Allostatic regulation permits context-dependent reference trajectories.",
      "description": "The target of regulation can move with predicted demand rather than remain a fixed set point.",
