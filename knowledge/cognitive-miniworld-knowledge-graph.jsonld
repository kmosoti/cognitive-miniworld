      "@id": "cmw:source/cogitate-2025",
      "@type": "schema:ScholarlyArticle"
    },
    {
      "label": "Critical periods in speech perception: new directions",
      "author": [
        "Janet F. Werker",
        "Takao K. Hensch"
      ],
      "datePublished": "2015",
      "journal": "Annual Review of Psychology 66:173-196",
      "url": "https://pubmed.ncbi.nlm.nih.gov/25251488/",
      "evidenceClass": "cmw:evidence/review-synthesis",
      "doi": "10.1146/annurev-psych-010814-015104",
      "sameAs": "https://doi.org/10.1146/annurev-psych-010814-015104",
      "@id": "cmw:source/werker-hensch-2015",
      "@type": "schema:ScholarlyArticle"
    },
    {
      "label": "ObservationEnvelope",
      "description": "A time-stamped, provenance-bearing observation with modality, latency, reliability, and uncertainty metadata.",
      "@id": "cmw:contract/observation-envelope",
      "@type": "cmw:DataContract"
    },
    {
      "label": "BeliefState",
      "description": "A probability-bearing estimate of latent world and body state with evidence links and revision time.",
      "@id": "cmw:contract/belief-state",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ReferenceTrajectory",
      "description": "A desired range over time with tolerance, priority, provenance, and prediction horizon.",
      "@id": "cmw:contract/reference-trajectory",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ActionProposal",
      "description": "A candidate action with preconditions, parameters, reversibility, estimated cost, and generator provenance.",
      "@id": "cmw:contract/action-proposal",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ActionDecision",
      "description": "The selected action, intensity, arbitration rationale, and uncertainty.",
      "@id": "cmw:contract/action-decision",
      "@type": "cmw:DataContract"
    },
    {
      "label": "PredictionDistribution",
      "description": "A distribution over future states and observations conditional on belief and action.",
      "@id": "cmw:contract/prediction-distribution",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ErrorBundle",
      "description": "A vector of typed discrepancies including sensory, state revision, control, outcome, timing, agency, and learning-progress channels.",
      "@id": "cmw:contract/error-bundle",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ExperienceTrace",
      "description": "A provenance-rich episode linking context, beliefs, references, predictions, actions, outcomes, errors, and eligibility.",
      "@id": "cmw:contract/experience-trace",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ResourceBudget",
      "description": "The available time, compute, memory, risk, and energy proxy for a decision cycle.",
      "@id": "cmw:contract/resource-budget",
      "@type": "cmw:DataContract"
    },
    {
      "label": "SelfEstimate",
      "description": "Calibrated estimates of sensor reliability, model competence, resource state, and recent failure regime.",
      "@id": "cmw:contract/self-estimate",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ProcessingPriority",
      "description": "A ranked processing request with value, urgency, provenance, deadline, and estimated computation cost.",
      "@id": "cmw:contract/processing-priority",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ComputeAllocation",
      "description": "A bounded decision about which computation to run, at what intensity, and when to stop.",
      "@id": "cmw:contract/compute-allocation",
      "@type": "cmw:DataContract"
    },
    {
      "label": "AppraisalVector",
      "description": "A continuous control-mode vector including harm, benefit, certainty, imminence, controllability, agency, urgency, and approach or avoidance bias.",
      "@id": "cmw:contract/appraisal-vector",
      "@type": "cmw:DataContract"
    },
    {
      "label": "WorkspaceState",
      "description": "A bounded set of active representations with admission, maintenance, replacement, and suppression metadata.",
      "@id": "cmw:contract/workspace-state",
      "@type": "cmw:DataContract"
    },
    {
      "label": "PlasticitySchedule",
      "description": "A policy over learning rate, replay, consolidation, exploration, growth, and pruning.",
      "@id": "cmw:contract/plasticity-schedule",
      "@type": "cmw:DataContract"
    },
    {
      "label": "ReferenceGenerator",
      "implementationTier": "regulation",
      "contractQuestion": "What future states should remain viable under current and predicted demand?",
      "objective": "Produce context-sensitive reference trajectories rather than one static set point.",
      "inputType": [
        "cmw:contract/belief-state",
        "cmw:contract/resource-budget"
      ],
      "outputType": [
        "cmw:contract/reference-trajectory"
      ],
      "dependsOn": [],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/dynamic-reference-trajectories",
        "cmw:claim/resource-process-distinction",
        "cmw:claim/capacity-as-headroom",
        "cmw:claim/state-dependent-value"
      ],
      "testedBy": [
        "cmw:experiment/dynamic-demand-shift"
      ],
      "@id": "cmw:primitive/reference-generator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "StateEstimator",
      "implementationTier": "core",
      "contractQuestion": "What is probably true now?",
      "objective": "Fuse partial, noisy, delayed observations into a calibrated belief distribution.",
      "inputType": [
        "cmw:contract/observation-envelope",
        "cmw:contract/belief-state"
      ],
      "outputType": [
        "cmw:contract/belief-state"
      ],
      "dependsOn": [],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/sensorimotor-internal-model"
      ],
      "testedBy": [
        "cmw:experiment/partial-observability",
        "cmw:experiment/stale-memory"
      ],
      "mitigates": [
        "cmw:failure/stale-memory-substitution"
      ],
      "@id": "cmw:primitive/state-estimator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "ForwardModel",
      "implementationTier": "core",
      "contractQuestion": "What is likely to happen after a candidate action?",
      "objective": "Predict future states, observations, and timing conditional on action.",
      "inputType": [
        "cmw:contract/belief-state",
        "cmw:contract/action-proposal"
      ],
      "outputType": [
        "cmw:contract/prediction-distribution"
      ],
      "dependsOn": [
        "cmw:primitive/state-estimator"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/sensorimotor-internal-model",
        "cmw:claim/predictive-coding-sufficiency"
      ],
      "testedBy": [
        "cmw:experiment/transition-shift"
      ],
      "mitigates": [
        "cmw:failure/model-staleness"
      ],
      "@id": "cmw:primitive/forward-model",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "ErrorDecomposer",
      "implementationTier": "core",
      "contractQuestion": "In what way was the system wrong or off trajectory?",
      "objective": "Keep prediction, control, outcome, timing, agency, and learning-progress errors distinct.",
      "inputType": [
        "cmw:contract/prediction-distribution",
        "cmw:contract/belief-state",
        "cmw:contract/reference-trajectory",
        "cmw:contract/observation-envelope"
      ],
      "outputType": [
        "cmw:contract/error-bundle"
      ],
      "dependsOn": [
        "cmw:primitive/state-estimator",
        "cmw:primitive/forward-model"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/prediction-control-error-distinction",
        "cmw:claim/predictive-coding-sufficiency",
        "cmw:claim/reward-prediction-error"
      ],
      "testedBy": [
        "cmw:experiment/error-disagreement"
      ],
      "mitigates": [
        "cmw:failure/scalar-error-collapse"
      ],
      "@id": "cmw:primitive/error-decomposer",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "AffordanceGenerator",
      "implementationTier": "core",
      "contractQuestion": "What actions are currently possible?",
      "objective": "Generate action candidates before final arbitration.",
      "inputType": [
        "cmw:contract/belief-state"
      ],
      "outputType": [
        "cmw:contract/action-proposal"
      ],
      "dependsOn": [
        "cmw:primitive/state-estimator"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/parallel-affordance-competition"
      ],
      "testedBy": [
        "cmw:experiment/affordance-coverage"
      ],
      "mitigates": [
        "cmw:failure/affordance-blindness"
      ],
      "@id": "cmw:primitive/affordance-generator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "ActionArbitrator",
      "implementationTier": "core",
      "contractQuestion": "Which action should be selected, inhibited, or intensified?",
      "objective": "Trade goal progress, risk, information value, cost, reversibility, and deadline.",
      "inputType": [
        "cmw:contract/action-proposal",
        "cmw:contract/prediction-distribution",
        "cmw:contract/error-bundle",
        "cmw:contract/resource-budget"
      ],
      "outputType": [
        "cmw:contract/action-decision"
      ],
      "dependsOn": [
        "cmw:primitive/affordance-generator",
        "cmw:primitive/forward-model",
        "cmw:primitive/error-decomposer"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/resource-process-distinction",
        "cmw:claim/capacity-as-headroom",
        "cmw:claim/state-dependent-value",
        "cmw:claim/parallel-affordance-competition",
        "cmw:claim/uncertainty-controller-arbitration",
        "cmw:claim/graded-decision-confidence"
      ],
      "testedBy": [
        "cmw:experiment/delayed-action-arbitration",
        "cmw:experiment/appraisal-contrast"
      ],
      "@id": "cmw:primitive/action-arbitrator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "SalienceRouter",
      "implementationTier": "adaptive",
      "contractQuestion": "Which signals deserve scarce processing?",
      "objective": "Prioritize behaviorally useful information under distractor load.",
      "inputType": [
        "cmw:contract/observation-envelope",
        "cmw:contract/error-bundle",
        "cmw:contract/reference-trajectory"
      ],
      "outputType": [
        "cmw:contract/processing-priority"
      ],
      "dependsOn": [
        "cmw:primitive/error-decomposer"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
