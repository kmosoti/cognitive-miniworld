      ],
      "@id": "cmw:primitive/workspace-gate",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "PlasticityScheduler",
      "implementationTier": "deferred",
      "contractQuestion": "When should learning rates, consolidation, exploration, or structural growth change?",
      "objective": "Test developmental timing only after the fixed learning loop is measurable.",
      "inputType": [
        "cmw:contract/experience-trace",
        "cmw:contract/self-estimate"
      ],
      "outputType": [
        "cmw:contract/plasticity-schedule"
      ],
      "dependsOn": [
        "cmw:primitive/consolidator",
