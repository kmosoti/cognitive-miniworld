      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/graded-decision-confidence"
      ],
      "testedBy": [
        "cmw:experiment/sensor-degradation"
      ],
      "@id": "cmw:primitive/self-estimator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "WorkspaceGate",
      "implementationTier": "deferred",
      "contractQuestion": "Does bounded cross-subsystem broadcast improve coordination?",
      "objective": "Test broadcast as a coordination mechanism without treating it as proof of consciousness.",
      "inputType": [
        "cmw:contract/workspace-state",
        "cmw:contract/processing-priority"
      ],
      "outputType": [
        "cmw:contract/workspace-state"
      ],
