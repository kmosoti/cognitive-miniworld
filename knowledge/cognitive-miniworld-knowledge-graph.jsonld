    {
      "identifier": "MW-EPIC-001",
      "label": "Build the Cognitive Miniworld Primitive Testbed",
      "description": "Implement a deterministic, partially observable miniworld and an ablation-first agent harness that can falsify the project hypotheses one primitive at a time.",
      "objective": "Deliver reproducible evidence about whether candidate primitives improve regulation, epistemics, learning, and compute efficiency over explicit baselines.",
      "status": "active",
      "implements": "cmw:miniworld/viability-grid",
      "hypothesis": [
        "cmw:theory/endogenous-regulation",
        "cmw:theory/appraisal-control-signals",
        "cmw:theory/useful-curiosity",
        "cmw:theory/memory-is-evidence",
        "cmw:theory/resource-bounded-cognition",
        "cmw:theory/language-is-optional"
      ],
      "hasPart": [
        "cmw:work/MW-FOUNDATION",
        "cmw:work/MW-CORE",
        "cmw:work/MW-REGULATION",
        "cmw:work/MW-ALLOCATION",
        "cmw:work/MW-LEARNING",
        "cmw:work/MW-APPRAISAL",
        "cmw:work/MW-DEFERRED"
      ],
      "acceptanceCriterion": [
        "Every run replays to the same terminal-state and event-log hash from its manifest and seed.",
        "Every promoted primitive has a paired-seed baseline, an ablation, a preregistered primary metric, and a kill criterion.",
        "Hidden ground truth is inaccessible to candidate primitives and available only to the evaluator.",
        "At least the core chain StaticReferenceProvider → StateEstimator → ForwardModel → ErrorDecomposer → AffordanceGenerator → ActionArbitrator passes its release gates without an LLM; the dynamic ReferenceGenerator is promoted in the regulation milestone.",
        "The knowledge graph links every implemented primitive to bounded evidence claims and to at least one adversarial experiment."
      ],
      "@id": "cmw:epic/MW-EPIC-001",
      "@type": [
        "cmw:Epic",
        "schema:Project"
      ]
    },
    {
      "identifier": "MW-FOUNDATION",
      "label": "Foundation and reproducibility",
      "description": "Build contracts, deterministic kernel, event sourcing, scenario manifests, telemetry, baselines, and oracle.",
      "status": "complete",
      "implements": [],
      "dependsOn": [],
      "isPartOf": "cmw:epic/MW-EPIC-001",
      "hasPart": [
        "cmw:issue/MW-001",
        "cmw:issue/MW-002",
        "cmw:issue/MW-003",
        "cmw:issue/MW-004",
        "cmw:issue/MW-005",
        "cmw:issue/MW-006",
        "cmw:issue/MW-007"
      ],
      "acceptanceCriterion": [
        "Deterministic replay passes end to end.",
        "Baseline performance is stable enough to expose a measurable oracle gap."
      ],
      "@id": "cmw:work/MW-FOUNDATION",
      "@type": "cmw:WorkPackage"
    },
    {
      "identifier": "MW-CORE",
      "label": "Predictive closed-loop spine",
      "description": "Establish the smallest nonlinguistic loop that can estimate, predict, compare, choose, act, and learn from error.",
      "status": "complete",
      "implements": [
        "cmw:primitive/state-estimator",
        "cmw:primitive/forward-model",
        "cmw:primitive/error-decomposer",
        "cmw:primitive/affordance-generator",
        "cmw:primitive/action-arbitrator"
      ],
      "dependsOn": [
        "cmw:work/MW-FOUNDATION"
      ],
      "isPartOf": "cmw:epic/MW-EPIC-001",
      "hasPart": [
        "cmw:issue/MW-010",
        "cmw:issue/MW-011",
        "cmw:issue/MW-012",
        "cmw:issue/MW-013",
        "cmw:issue/MW-014"
      ],
      "acceptanceCriterion": [
        "The nonlinguistic loop survives, recovers from hidden-state errors, and outperforms a reactive controller in a delayed-consequence scenario."
      ],
      "@id": "cmw:work/MW-CORE",
      "@type": "cmw:WorkPackage"
    },
    {
      "identifier": "MW-REGULATION",
      "label": "Endogenous regulation",
      "description": "Replace static externally supplied targets with predicted viability trajectories and state-relative value.",
      "status": "proposed",
      "implements": [
        "cmw:primitive/reference-generator"
      ],
      "dependsOn": [
        "cmw:work/MW-CORE"
      ],
      "isPartOf": "cmw:epic/MW-EPIC-001",
      "hasPart": [
        "cmw:issue/MW-020",
        "cmw:issue/MW-021"
      ],
      "acceptanceCriterion": [
        "Dynamic references beat fixed set points on the preregistered demand-shift experiment without increasing irreversible errors."
      ],
      "@id": "cmw:work/MW-REGULATION",
      "@type": "cmw:WorkPackage"
    },
    {
      "identifier": "MW-ALLOCATION",
      "label": "Salience, curiosity, and metacontrol",
      "description": "Allocate attention and compute under distractor floods, learnable uncertainty, and irreducible noise.",
      "status": "proposed",
      "implements": [
        "cmw:primitive/salience-router",
        "cmw:primitive/metacontrol-allocator",
        "cmw:primitive/epistemic-controller"
      ],
      "dependsOn": [
