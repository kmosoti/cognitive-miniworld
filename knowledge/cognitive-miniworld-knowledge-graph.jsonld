      ],
      "mitigates": [
        "cmw:failure/language-substitution"
      ],
      "@id": "cmw:primitive/language-adapter",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "Emotion enum",
      "description": "Named emotions are treated as downstream labels over appraisal and policy state, not as the machinery itself.",
      "replacedBy": "cmw:primitive/appraiser",
      "epistemicStatus": "cmw:status/engineering-inference",
      "@id": "cmw:nonprimitive/emotion-enum",
      "@type": "cmw:NonPrimitive"
    },
    {
      "label": "Motivation module",
