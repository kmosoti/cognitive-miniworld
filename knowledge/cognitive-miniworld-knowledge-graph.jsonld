    {
      "label": "Cognitive Miniworld Research Program",
      "description": "A falsifiable, black-box testbed for cognitive control primitives inspired by neurobiology without asserting one-to-one brain-to-software identity.",
      "objective": "Determine which candidate primitives independently improve regulation, epistemic calibration, adaptation, and value-per-compute under controlled partial observability.",
      "nonGoal": [
        "Reproduce a human brain.",
        "Claim consciousness from architecture alone.",
        "Treat a named brain region as a deployable software module.",
        "Use an LLM as a substitute for state estimation, control, or learning."
      ],
      "hasPart": [
        "cmw:theory/endogenous-regulation",
        "cmw:theory/appraisal-control-signals",
        "cmw:theory/useful-curiosity",
        "cmw:theory/memory-is-evidence",
        "cmw:theory/resource-bounded-cognition",
        "cmw:epic/MW-EPIC-001"
      ],
      "@id": "cmw:project/cognitive-miniworld",
      "@type": [
        "schema:ResearchProject",
        "cmw:ResearchProgram"
      ]
    },
    {
      "label": "Interoception as modeling, allostasis as control — a reader's schematic",
      "description": "User-provided HTML schematic of Sennesh et al. (2022), explicitly labeled as a theory paper with no new data.",
      "identifier": "allostasis-as-control.html",
      "evidenceClass": "cmw:evidence/source-schematic",
      "sourceLocator": [
        "Lines 182-188: source metadata and allostatic-control thesis.",
        "Lines 200-229: homeostasis versus allostasis; regulated resource versus controlled process.",
        "Lines 305-309: disturbance, open-loop plans, forward/inverse models, prediction error versus control error.",
        "Lines 314-334: APIC formalism and claimed unification.",
        "Lines 337-361: falsifiability and open anatomical questions.",
        "Lines 383-389: analogy boundaries and evidence ceiling."
      ],
      "derivedFrom": "cmw:source/sennesh-2022",
      "@id": "cmw:source/starter-schematic",
      "@type": [
        "schema:CreativeWork",
        "cmw:ReaderSchematic"
      ]
