      ],
      "epistemicStatus": "cmw:status/deferred",
      "supportedBy": [
        "cmw:claim/plasticity-window-mechanisms"
      ],
      "@id": "cmw:primitive/plasticity-scheduler",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "LanguageAdapter",
      "implementationTier": "deferred",
      "contractQuestion": "What does linguistic reasoning add to an already functioning cognitive loop?",
      "objective": "Treat language as an optional symbolic interface, not the substrate of cognition.",
      "inputType": [
        "cmw:contract/belief-state",
        "cmw:contract/experience-trace"
      ],
      "outputType": [
        "cmw:contract/action-proposal"
      ],
      "dependsOn": [
        "cmw:primitive/workspace-gate"
      ],
      "epistemicStatus": "cmw:status/deferred",
      "testedBy": [
