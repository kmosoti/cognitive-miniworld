        "cmw:issue/MW-042",
        "cmw:issue/MW-043",
        "cmw:issue/MW-044"
      ],
      "acceptanceCriterion": [
        "The agent gains efficiency from experience without catastrophic overwrite, superstition, or irreversible habit rigidity."
      ],
      "@id": "cmw:work/MW-LEARNING",
      "@type": "cmw:WorkPackage"
    },
    {
      "identifier": "MW-APPRAISAL",
      "label": "Appraisal and self-estimation",
