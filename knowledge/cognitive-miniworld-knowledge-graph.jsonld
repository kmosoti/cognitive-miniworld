    {
      "label": "Causal intervention",
      "description": "An intervention manipulated a candidate mechanism and measured downstream behavior.",
      "@id": "cmw:evidence/causal-intervention",
      "@type": "skos:Concept"
    },
    {
      "label": "Behavioral experiment",
      "description": "Behavioral data were collected under controlled task conditions.",
      "@id": "cmw:evidence/behavioral-experiment",
      "@type": "skos:Concept"
    },
    {
      "label": "Observational neuroscience",
      "description": "Neural activity or connectivity was measured without a decisive causal intervention.",
      "@id": "cmw:evidence/observational-neuroscience",
      "@type": "skos:Concept"
    },
    {
      "label": "Computational model",
