        "cmw:issue/MW-030",
        "cmw:issue/MW-031",
        "cmw:issue/MW-032"
      ],
      "acceptanceCriterion": [
        "The agent distinguishes novelty from learnability and avoids both distraction capture and unlimited deliberation."
      ],
      "@id": "cmw:work/MW-ALLOCATION",
      "@type": "cmw:WorkPackage"
    },
    {
      "identifier": "MW-LEARNING",
      "label": "Memory, credit, consolidation, and habits",
      "description": "Test fast versus slow learning, delayed credit, provenance, and reversible skill compilation.",
      "status": "proposed",
      "implements": [
        "cmw:primitive/episodic-recorder",
        "cmw:primitive/working-memory-gate",
        "cmw:primitive/credit-assigner",
        "cmw:primitive/consolidator",
        "cmw:primitive/procedural-policy",
        "cmw:primitive/policy-invalidator"
      ],
      "dependsOn": [
