    },
    {
      "label": "Cognitive operations should be purchased only when their expected decision value exceeds their cost.",
      "description": "Salience selects what may matter; metacontrol decides whether additional computation is worth running.",
      "supportedBy": [
        "cmw:claim/salience-executive-network-distinction",
        "cmw:claim/expected-value-of-control",
        "cmw:claim/resource-rational-method"
      ],
      "testedBy": [
        "cmw:experiment/distractor-flood",
        "cmw:experiment/compute-budget"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:theory/resource-bounded-cognition",
      "@type": "cmw:CandidateTheory"
    },
    {
      "label": "Language is an optional symbolic interface rather than a prerequisite for the core loop.",
      "description": "The first milestones test regulation, prediction, learning, and action without an LLM.",
      "supportedBy": [
        "cmw:claim/workspace-theory-challenge"
      ],
      "testedBy": [
        "cmw:experiment/language-ablation"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:theory/language-is-optional",
      "@type": "cmw:CandidateTheory"
    },
    {
      "label": "Viability area under curve",
      "direction": "Higher is better",
      "unit": "integral of normalized viable-state margin over time",
      "@id": "cmw:metric/viability-auc",
      "@type": "cmw:Metric"
    },
    {
      "label": "Time outside viability range",
      "direction": "Lower is better",
      "unit": "ticks",
      "@id": "cmw:metric/time-outside-viability",
      "@type": "cmw:Metric"
    },
    {
      "label": "Belief calibration Brier score",
      "direction": "Lower is better",
      "unit": "mean squared probability error",
      "@id": "cmw:metric/belief-brier",
      "@type": "cmw:Metric"
    },
    {
      "label": "Belief negative log likelihood",
      "direction": "Lower is better",
      "unit": "nats per latent-state target",
      "@id": "cmw:metric/belief-nll",
      "@type": "cmw:Metric"
    },
    {
      "label": "False-belief persistence",
      "direction": "Lower is better",
      "unit": "ticks until posterior recovery",
      "@id": "cmw:metric/false-belief-persistence",
      "@type": "cmw:Metric"
    },
    {
      "label": "Prediction loss",
      "direction": "Lower is better",
      "unit": "task-specific proper scoring rule",
      "@id": "cmw:metric/prediction-loss",
      "@type": "cmw:Metric"
    },
    {
      "label": "Decision regret",
      "direction": "Lower is better",
      "unit": "oracle value minus realized value",
      "@id": "cmw:metric/regret",
      "@type": "cmw:Metric"
    },
    {
      "label": "Irreversible mistake count",
      "direction": "Lower is better",
      "unit": "count",
      "@id": "cmw:metric/irreversible-errors",
      "@type": "cmw:Metric"
    },
    {
      "label": "Action oscillation",
      "direction": "Lower is better",
      "unit": "policy switches without state justification",
      "@id": "cmw:metric/action-oscillation",
      "@type": "cmw:Metric"
    },
    {
      "label": "Behavioral value per compute",
      "direction": "Higher is better",
      "unit": "viability or regret improvement per compute unit",
      "@id": "cmw:metric/value-per-compute",
      "@type": "cmw:Metric"
    },
    {
      "label": "Noisy-TV dwell",
      "direction": "Lower is better after learnability estimate converges",
      "unit": "ticks",
      "@id": "cmw:metric/noisy-tv-dwell",
      "@type": "cmw:Metric"
    },
    {
      "label": "Useful information gain",
      "direction": "Higher is better",
      "unit": "downstream prediction or decision improvement",
      "@id": "cmw:metric/useful-information-gain",
      "@type": "cmw:Metric"
    },
    {
      "label": "Adaptation half-life",
      "direction": "Lower is better",
      "unit": "ticks to recover half of post-shift performance gap",
      "@id": "cmw:metric/adaptation-half-life",
      "@type": "cmw:Metric"
    },
    {
      "label": "Catastrophic interference",
      "direction": "Lower is better",
      "unit": "loss on retained tasks after new learning",
      "@id": "cmw:metric/catastrophic-interference",
      "@type": "cmw:Metric"
    },
    {
      "label": "Credit assignment precision",
      "direction": "Higher is better",
      "unit": "fraction of updates assigned to true causal contributors",
      "@id": "cmw:metric/credit-precision",
      "@type": "cmw:Metric"
    },
    {
      "label": "Replay hash match",
      "direction": "Must equal one",
      "unit": "binary deterministic replay invariant",
      "@id": "cmw:metric/replay-hash-match",
      "@type": "cmw:Metric"
    },
    {
      "label": "Self-confidence calibration",
      "direction": "Lower calibration error is better",
      "unit": "expected calibration error or Brier score",
      "@id": "cmw:metric/confidence-calibration",
      "@type": "cmw:Metric"
    },
    {
      "label": "Feasible action recall",
      "direction": "Higher is better",
      "unit": "fraction of oracle-feasible actions retained, weighted by oracle value",
      "@id": "cmw:metric/feasible-action-recall",
      "@type": "cmw:Metric"
    },
    {
      "label": "Invalid action proposal rate",
      "direction": "Lower is better",
      "unit": "fraction of proposals violating known preconditions",
      "@id": "cmw:metric/invalid-action-rate",
      "@type": "cmw:Metric"
    },
    {
      "label": "Critical signal retention",
      "direction": "Higher is better",
      "unit": "fraction of causally or viability-critical representations retained until use",
      "@id": "cmw:metric/critical-signal-retention",
      "@type": "cmw:Metric"
    },
    {
      "label": "Retrieval decision delta",
      "direction": "Higher is better",
      "unit": "paired decision quality with retrieval minus without retrieval",
      "@id": "cmw:metric/decision-delta",
      "@type": "cmw:Metric"
    },
    {
      "label": "Stale episode selection rate",
      "direction": "Lower is better",
      "unit": "fraction of retrieval decisions selecting a stale partial match",
      "@id": "cmw:metric/stale-selection-rate",
      "@type": "cmw:Metric"
    },
    {
      "label": "ViabilityGrid Miniworld",
      "description": "A seeded, discrete-time, partially observable world with endogenous body variables, costly actions, delayed outcomes, predictable demand changes, distractor floods, stochastic noise, and sensor degradation.",
      "scenarioVariable": [
        "energy",
        "integrity",
        "ambient demand",
        "resource location",
        "resource quality",
        "hazard state",
        "sensor reliability",
        "compute budget",
        "time horizon"
      ],
      "action": [
        "move",
        "inspect",
        "consume",
        "rest",
        "probe",
        "wait",
        "retreat"
      ],
      "observationChannel": [
        "local exteroception",
        "noisy interoception",
        "event timing",
        "action efference copy"
      ],
      "invariant": [
        "World transition is a pure function of prior state, action, and explicit RNG state.",
        "Every run is replayable from scenario manifest, seed, agent version, and event log.",
        "The hidden world state is never passed directly to candidate primitives.",
        "Oracle access exists only in evaluation code.",
        "Every primitive can be disabled independently."
      ],
      "hasPart": [
        "cmw:experiment/dynamic-demand-shift",
        "cmw:experiment/partial-observability",
        "cmw:experiment/transition-shift",
        "cmw:experiment/affordance-coverage",
        "cmw:experiment/working-memory-interference",
        "cmw:experiment/error-disagreement",
        "cmw:experiment/distractor-flood",
        "cmw:experiment/compute-budget",
        "cmw:experiment/learnable-unknown",
        "cmw:experiment/noisy-tv",
        "cmw:experiment/delayed-credit",
        "cmw:experiment/consolidation-interference",
        "cmw:experiment/stale-memory",
        "cmw:experiment/delayed-action-arbitration",
        "cmw:experiment/appraisal-contrast",
        "cmw:experiment/sensor-degradation",
        "cmw:experiment/habit-reversal",
        "cmw:experiment/language-ablation"
      ],
      "@id": "cmw:miniworld/viability-grid",
      "@type": [
        "cmw:Miniworld",
        "schema:SoftwareApplication"
      ]
    },
    {
      "label": "Predictable demand shift",
      "description": "A dynamic reference generator anticipates rising demand and reduces time outside viability relative to a fixed set point.",
      "tests": [
        "cmw:primitive/reference-generator"
      ],
      "primaryMetric": "cmw:metric/time-outside-viability",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/reactive-static"
      ],
      "failureMode": [
        "cmw:failure/proxy-regulation"
      ],
      "killTest": "Reject the candidate if it does not improve the preregistered primary metric against paired-seed fixed-setpoint control, or if it worsens safety beyond the preregistered noninferiority margin.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/dynamic-demand-shift",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Partial observability and stale belief",
      "description": "A calibrated belief distribution improves action under hidden state and contradictory sensors.",
      "tests": [
        "cmw:primitive/state-estimator"
      ],
      "primaryMetric": "cmw:metric/belief-brier",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/last-observation"
      ],
      "failureMode": [
        "cmw:failure/stale-memory-substitution"
      ],
      "killTest": "Reject if calibrated state estimation does not outperform last-observation carry-forward or if false beliefs persist longer after corrective evidence.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/partial-observability",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Action-conditioned transition shift",
      "description": "An action-conditioned forward model improves proper-scoring prediction and revises itself after an abrupt change in world dynamics.",
      "tests": [
        "cmw:primitive/forward-model"
      ],
      "primaryMetric": "cmw:metric/prediction-loss",
      "safetyMetric": "cmw:metric/adaptation-half-life",
      "baseline": [
        "cmw:baseline/identity-forward-model",
        "cmw:baseline/frozen-transition-model",
        "cmw:baseline/reactive-static"
      ],
      "failureMode": [
        "cmw:failure/model-staleness"
      ],
      "killTest": "Reject if the model does not beat the identity baseline before the shift, does not detect and adapt after the shift, or improves prediction without improving at least one downstream decision metric.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/transition-shift",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Affordance coverage under hidden constraints",
      "description": "The affordance generator reduces impossible proposals while retaining high-value feasible actions under uncertain preconditions.",
      "tests": [
        "cmw:primitive/affordance-generator"
      ],
      "primaryMetric": "cmw:metric/feasible-action-recall",
      "safetyMetric": "cmw:metric/invalid-action-rate",
      "baseline": [
        "cmw:baseline/enumerate-all-actions",
        "cmw:baseline/goal-only-proposals"
      ],
      "failureMode": [
        "cmw:failure/affordance-blindness"
      ],
      "killTest": "Reject if candidate-set reduction causes the best feasible action to be omitted more often than the preregistered recall floor, or if invalid proposals are not reduced.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/affordance-coverage",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Working-memory interference and churn",
      "description": "A bounded gate preserves causally and viability-relevant representations under distractor churn while reducing processing cost.",
      "tests": [
        "cmw:primitive/working-memory-gate"
      ],
      "primaryMetric": "cmw:metric/critical-signal-retention",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/unbounded-context",
        "cmw:baseline/fifo-working-memory"
      ],
      "failureMode": [
        "cmw:failure/context-churn"
      ],
      "killTest": "Reject if bounded gating does not preserve critical information better than FIFO, or if compute savings are purchased by materially worse viability.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/working-memory-interference",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Typed error disagreement",
      "description": "Typed errors produce more targeted learning than a scalar absolute-error signal when prediction and control errors disagree.",
      "tests": [
        "cmw:primitive/error-decomposer"
      ],
      "primaryMetric": "cmw:metric/credit-precision",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/scalar-error"
      ],
      "failureMode": [
        "cmw:failure/scalar-error-collapse"
      ],
      "killTest": "Reject if typed errors do not improve update targeting, fail to trigger necessary control in expected-but-undesirable scenarios, or induce unnecessary control in unexpected-but-safe scenarios.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/error-disagreement",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Distractor flood",
      "description": "Salience routing retains subtle viability-critical signals while suppressing high-volume irrelevant novelty.",
      "tests": [
        "cmw:primitive/salience-router"
      ],
      "primaryMetric": "cmw:metric/value-per-compute",
      "safetyMetric": "cmw:metric/time-outside-viability",
      "baseline": [
        "cmw:baseline/fifo-router",
        "cmw:baseline/novelty-router"
      ],
      "failureMode": [
        "cmw:failure/novelty-hijack"
      ],
      "killTest": "Reject if the router misses critical signals more often than a FIFO baseline or spends equal compute without decision improvement.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/distractor-flood",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Bounded compute allocation",
      "description": "Metacontrol spends extra computation only when it improves consequential decisions.",
      "tests": [
        "cmw:primitive/metacontrol-allocator"
      ],
      "primaryMetric": "cmw:metric/value-per-compute",
      "safetyMetric": "cmw:metric/irreversible-errors",
      "baseline": [
        "cmw:baseline/fixed-budget",
        "cmw:baseline/always-max-compute"
      ],
      "failureMode": [
        "cmw:failure/overthinking-sink"
      ],
      "killTest": "Reject if adaptive allocation cannot dominate at least one fixed-budget policy on value-per-compute without increasing irreversible errors.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/compute-budget",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Learnable unknown",
      "description": "Expected learning progress sustains exploration of a difficult but learnable region.",
      "tests": [
        "cmw:primitive/epistemic-controller"
      ],
      "primaryMetric": "cmw:metric/useful-information-gain",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/random-exploration",
        "cmw:baseline/prediction-error-curiosity"
      ],
      "failureMode": [
        "cmw:failure/noisy-tv"
      ],
      "killTest": "Reject if exploration decays before model improvement or if acquired information does not improve downstream prediction or action.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/learnable-unknown",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Irreducible noisy-TV source",
      "description": "The epistemic controller disengages from high-entropy stimuli once learnability is estimated as low.",
      "tests": [
        "cmw:primitive/epistemic-controller"
      ],
      "primaryMetric": "cmw:metric/noisy-tv-dwell",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/prediction-error-curiosity"
      ],
      "failureMode": [
        "cmw:failure/noisy-tv"
      ],
      "killTest": "Reject if dwell remains high after repeated evidence that prediction loss is not improving.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/noisy-tv",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Delayed causal credit",
      "description": "Eligibility traces assign delayed outcomes to causal contributors more precisely than global reinforcement.",
      "tests": [
        "cmw:primitive/credit-assigner"
      ],
      "primaryMetric": "cmw:metric/credit-precision",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/global-reinforcement"
      ],
      "failureMode": [
        "cmw:failure/global-credit-superstition"
      ],
      "killTest": "Reject if noncausal distractors receive comparable updates to true contributors.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/delayed-credit",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Fast episode versus slow integration",
      "description": "Fast episodic storage plus interleaved consolidation learns exceptions without catastrophic overwrite.",
      "tests": [
        "cmw:primitive/episodic-recorder",
        "cmw:primitive/consolidator"
      ],
      "primaryMetric": "cmw:metric/catastrophic-interference",
      "safetyMetric": "cmw:metric/adaptation-half-life",
      "baseline": [
        "cmw:baseline/single-store-immediate-update"
      ],
      "failureMode": [
        "cmw:failure/stale-memory-substitution"
      ],
      "killTest": "Reject if the two-speed design does not reduce interference or cannot revise a false generalization.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/consolidation-interference",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Memory versus current evidence",
      "description": "Current evidence can override a strong historical prior when the environment changes.",
      "tests": [
        "cmw:primitive/state-estimator",
        "cmw:primitive/episodic-recorder"
      ],
      "primaryMetric": "cmw:metric/false-belief-persistence",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/memory-substitution"
      ],
      "failureMode": [
        "cmw:failure/stale-memory-substitution"
      ],
      "killTest": "Reject if retrieved history prevents posterior recovery after sufficient contradictory evidence.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/stale-memory",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Contextual episodic retrieval",
      "description": "A current cue and regime retrieve the exact recent episode ahead of a cue-matched stale regime, and the retrieved action improves paired decision quality over a fixed no-retrieval policy.",
      "tests": [
        "cmw:primitive/episodic-recorder"
      ],
      "primaryMetric": "cmw:metric/decision-delta",
      "safetyMetric": "cmw:metric/stale-selection-rate",
      "baseline": [
        "cmw:baseline/fixed-wait-no-retrieval"
      ],
      "failureMode": [
        "cmw:failure/stale-memory-substitution"
      ],
      "killTest": "Reject if mean paired decision delta is below 0.4, a stale partial match outranks the exact current context, or the selected exact-match score is below 1.0.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/contextual-episodic-retrieval",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Delayed-consequence action arbitration",
      "description": "On the canonical delayed_poison fixture, public predictive arbitration avoids a dominated irreversible consume while improving viability and reducing oracle regret against reactive fixed-setpoint control.",
      "tests": [
        "cmw:primitive/action-arbitrator"
      ],
      "primaryMetric": "cmw:metric/regret",
      "safetyMetric": "cmw:metric/irreversible-errors",
      "baseline": [
        "cmw:baseline/reactive-static"
      ],
      "failureMode": [
        "cmw:failure/proxy-regulation"
      ],
      "killTest": "Reject if the candidate fails to improve viability on any paired benchmark seed, incurs more than 0.03 oracle regret, fails to beat reactive regret, consumes irreversibly, or never demonstrates reversible dominance.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/delayed-action-arbitration",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Same valence, different control conditions",
      "description": "Changing certainty, imminence, agency, or controllability produces different control policies even when expected valence is held constant.",
      "tests": [
        "cmw:primitive/appraiser",
        "cmw:primitive/action-arbitrator"
      ],
      "primaryMetric": "cmw:metric/regret",
      "safetyMetric": "cmw:metric/irreversible-errors",
      "baseline": [
        "cmw:baseline/valence-only"
      ],
      "failureMode": [
        "cmw:failure/proxy-regulation"
      ],
      "killTest": "Reject if the appraisal vector does not improve policy differentiation over a valence-only baseline.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/appraisal-contrast",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Silent sensor degradation",
      "description": "A calibrated self-estimator detects declining reliability and changes evidence gathering or action intensity.",
      "tests": [
        "cmw:primitive/self-estimator",
        "cmw:primitive/metacontrol-allocator"
      ],
      "primaryMetric": "cmw:metric/confidence-calibration",
      "safetyMetric": "cmw:metric/irreversible-errors",
      "baseline": [
        "cmw:baseline/fixed-confidence"
      ],
      "failureMode": [
        "cmw:failure/proxy-regulation"
      ],
      "killTest": "Reject if confidence remains unchanged as accuracy falls or if behavior does not adapt to the reliability estimate.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/sensor-degradation",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Habit reversal after regime shift",
      "description": "Compiled policies save compute but are suspended quickly when their error signature shifts.",
      "tests": [
        "cmw:primitive/procedural-policy",
        "cmw:primitive/policy-invalidator"
      ],
      "primaryMetric": "cmw:metric/adaptation-half-life",
      "safetyMetric": "cmw:metric/irreversible-errors",
      "baseline": [
        "cmw:baseline/always-deliberative",
        "cmw:baseline/uninvalidated-habit"
      ],
      "failureMode": [
        "cmw:failure/habit-rigidity"
      ],
      "killTest": "Reject if the habit fails to save compute before the shift or persists materially longer than the invalidation threshold after the shift.",
      "isPartOf": "cmw:miniworld/viability-grid",
      "epistemicStatus": "cmw:status/project-hypothesis",
      "@id": "cmw:experiment/habit-reversal",
      "@type": "cmw:Experiment"
    },
    {
      "label": "Language contribution ablation",
      "description": "Any later language adapter must demonstrate incremental value over a nonlinguistic core rather than silently replacing it.",
      "tests": [
        "cmw:primitive/language-adapter"
      ],
      "primaryMetric": "cmw:metric/value-per-compute",
      "safetyMetric": "cmw:metric/viability-auc",
      "baseline": [
        "cmw:baseline/nonlinguistic-core"
      ],
      "failureMode": [
        "cmw:failure/language-substitution"
      ],
      "killTest": "Keep deferred until the nonlinguistic core passes its own gates; reject integration if language improves presentation but not task-grounded decisions.",
