      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/reward-prediction-error",
        "cmw:claim/eligibility-distal-credit-model"
      ],
      "testedBy": [
        "cmw:experiment/delayed-credit"
      ],
      "mitigates": [
        "cmw:failure/global-credit-superstition"
      ],
      "@id": "cmw:primitive/credit-assigner",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "Consolidator",
      "implementationTier": "learning",
      "contractQuestion": "Which repeated episodes should become slower general knowledge?",
      "objective": "Integrate episodes gradually while retaining provenance and reversibility.",
      "inputType": [
        "cmw:contract/experience-trace"
      ],
      "outputType": [
        "cmw:contract/belief-state"
      ],
      "dependsOn": [
        "cmw:primitive/episodic-recorder",
        "cmw:primitive/credit-assigner"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/complementary-learning-systems",
        "cmw:claim/sleep-reactivation",
        "cmw:claim/ripple-causal-consolidation"
      ],
      "testedBy": [
        "cmw:experiment/consolidation-interference"
      ],
      "@id": "cmw:primitive/consolidator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "ProceduralPolicy",
      "implementationTier": "learning",
      "contractQuestion": "Which repeated successful policy can execute cheaply?",
      "objective": "Compile repeated successful decisions into low-cost behavior.",
      "inputType": [
        "cmw:contract/belief-state"
      ],
      "outputType": [
        "cmw:contract/action-proposal"
      ],
      "dependsOn": [
        "cmw:primitive/credit-assigner"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/uncertainty-controller-arbitration"
      ],
      "testedBy": [
        "cmw:experiment/habit-reversal"
      ],
      "@id": "cmw:primitive/procedural-policy",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "PolicyInvalidator",
      "implementationTier": "learning",
      "contractQuestion": "When has a cheap learned policy become unsafe or stale?",
      "objective": "Suspend or decompile habits under distribution shift.",
      "inputType": [
        "cmw:contract/error-bundle",
        "cmw:contract/self-estimate"
      ],
      "outputType": [
        "cmw:contract/action-proposal"
      ],
      "dependsOn": [
        "cmw:primitive/procedural-policy",
        "cmw:primitive/error-decomposer"
      ],
      "epistemicStatus": "cmw:status/engineering-inference",
      "supportedBy": [
        "cmw:claim/uncertainty-controller-arbitration"
      ],
      "testedBy": [
        "cmw:experiment/habit-reversal"
      ],
      "mitigates": [
        "cmw:failure/habit-rigidity"
      ],
      "@id": "cmw:primitive/policy-invalidator",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "Appraiser",
      "implementationTier": "adaptive",
      "contractQuestion": "What does the predicted situation mean for the organism?",
      "objective": "Produce a continuous control-mode vector for harm, benefit, certainty, imminence, controllability, agency, and urgency.",
      "inputType": [
        "cmw:contract/belief-state",
        "cmw:contract/prediction-distribution",
        "cmw:contract/reference-trajectory"
      ],
      "outputType": [
        "cmw:contract/appraisal-vector"
      ],
      "dependsOn": [
        "cmw:primitive/state-estimator",
        "cmw:primitive/forward-model"
      ],
      "epistemicStatus": "cmw:status/project-hypothesis",
      "supportedBy": [
        "cmw:claim/appraisal-before-label"
      ],
      "testedBy": [
        "cmw:experiment/appraisal-contrast"
      ],
      "@id": "cmw:primitive/appraiser",
      "@type": "cmw:CognitivePrimitive"
    },
    {
      "label": "SelfEstimator",
      "implementationTier": "adaptive",
      "contractQuestion": "How reliable and capable is the system in this context?",
      "objective": "Calibrate model, sensor, and resource confidence for metacontrol and safe action.",
      "inputType": [
        "cmw:contract/experience-trace",
        "cmw:contract/error-bundle",
        "cmw:contract/resource-budget"
      ],
      "outputType": [
        "cmw:contract/self-estimate"
      ],
      "dependsOn": [
